# Log all calls, with arguments, to /var/log/messages
logger "$0" "$@"

export DISPLAY=:0
export XAUTHORITY=/home/chronos/.Xauthority

DEVICE=$(xinput list | sed '/Touchscreen/!d; s/.*id=//; s/\s.*//')

if test -z "$DEVICE"; then
  echo >&2 no touchscreen found
  exit 1
fi

xinput set-prop "$DEVICE" 'Dump Debug Log' 1

sleep 0.5

(cd /var/log/xorg; tar -cf - evdev_input_events.dat) |
    uuencode -m touchscreen_activity_log.tar
