# Log all calls, with arguments, to /var/log/messages
logger "$0" "$@"

XINPUT=/usr/bin/xinput

export DISPLAY=:0
export XAUTHORITY=/home/chronos/.Xauthority

PROG=`basename $0`
COMMAND=$1

. /opt/google/mouse/common

usage() {
  echo "Usage: $PROG {status|listdev}"
}

DEVICE="$(find_touchscreen)"
VALID=0

if [ "$DEVICE" = "" ] ; then
  $XINPUT list
  echo "ERROR: No touchscreen device found!"
  exit 1
elif [ "$COMMAND" = "status" -a $# = 1 ] ; then
  echo DEVICE: $DEVICE
  $XINPUT list-props $DEVICE
elif [ "$COMMAND" = "listdev" -a $# = 1 ] ; then
  echo $DEVICE
else
  usage
fi
